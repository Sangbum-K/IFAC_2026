<?xml version="1.0"?>
<package format="3">
  <name>f1tenth_stack</name>
  <version>0.0.0</version>
  <description>F1TENTH-style bringup package for vehicle launch and configuration.</description>
  <maintainer email="you@example.com">you</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>localization_bringup</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>urg_node</exec_depend>
  <exec_depend>vehicle_bringup</exec_depend>
  <exec_depend>vehicle_teleop</exec_depend>
  <exec_depend>vesc_ackermann</exec_depend>
  <exec_depend>vesc_driver</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
