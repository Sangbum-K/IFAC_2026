<?xml version="1.0"?>
<launch>
  <!-- Optionally launch in GDB, for debugging -->
  <arg name="debug" default="false" />
  <let name="launch_prefix" value="xterm -e gdb --args" if="$(var debug)" />

  <!-- Ackermann to VESC node -->
  <node pkg="vesc_ackermann" exec="ackermann_to_vesc_node" name="ackermann_to_vesc_node" output="screen">
    <!-- Pull calibration from f1tenth_stack/config/vesc.yaml so this standalone
         debug launch never drifts from the values used by bringup_launch.py -->
    <param from="$(find-pkg-share f1tenth_stack)/config/vesc.yaml" />
  </node>
</launch>
