<?xml version="1.0"?>
<package format="3">
  <name>perception_pkg</name>
  <version>0.1.0</version>
  <description>Laser obstacle detection and tracking package (C++).</description>
  <maintainer email="you@example.com">you</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>eigen3_cmake_module</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>eigen</depend>
  <depend>f1tenth_perception_msgs</depend>
  <!-- 트랙 경계(Frenet) 필터가 /global_waypoints(WpntArray)를 구독한다.
       파이썬 판에서는 임포트 실패 시 필터만 끄는 가드가 있어 exec_depend였지만,
       C++에서는 메시지 헤더가 컴파일 타임에 필요하므로 build depend다.
       build_all.sh가 planning_ws를 먼저 빌드하므로 순서는 이미 보장돼 있다. -->
  <depend>f1tenth_planning_msgs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
