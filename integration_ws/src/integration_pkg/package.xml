<?xml version="1.0"?>
<package format="3">
  <name>integration_pkg</name>
  <version>0.0.0</version>
  <description>Full-stack bringup launch and passive health monitor.</description>
  <maintainer email="you@example.com">you</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>ackermann_msgs</depend>
  <depend>f1tenth_planning_msgs</depend>
  <depend>f1tenth_perception_msgs</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <!-- map_saver_node.py (mapping.launch.py) -->
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- mapping.launch.py가 띄우는 SLAM 백엔드. localization_bringup의
       slam_toolbox_mapping.yaml을 그대로 쓴다. -->
  <exec_depend>slam_toolbox</exec_depend>
  <!-- real_car.launch.py에서만 쓰는 실차 워크스페이스. 시뮬 전용 PC에는 없어도
       stack.launch.py(env:=sim)는 그대로 동작하므로 exec_depend로만 둔다. -->
  <exec_depend>f1tenth_stack</exec_depend>
  <exec_depend>localization_bringup</exec_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
